# Environment Configuration Template
# Copy this file to .env and fill in your values

# Dataset Configuration
DATASET_PATH=data/raw/reviews.csv
DATASET_NAME=Microsoft/reviews
SAMPLE_SIZE=1000

# Model Configuration
MODEL_NAME=distilbert-base-uncased
NUM_LABELS=2
MAX_LENGTH=128
BATCH_SIZE=32
EPOCHS=3
LEARNING_RATE=2e-5

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sentiment-analysis
# MLFLOW_TRACKING_USERNAME=your_username
# MLFLOW_TRACKING_PASSWORD=your_password

# DVC Configuration
DVC_REMOTE_NAME=myremote
# DVC_REMOTE_URL=s3://your-bucket/dvc-storage
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False
API_WORKERS=4

# Cloud Deployment (Optional)
# AWS_REGION=us-east-1
# DOCKER_REGISTRY=your-registry.dkr.ecr.us-east-1.amazonaws.com
# DOCKER_IMAGE_NAME=sentiment-api

# Monitoring & Logging
LOG_LEVEL=INFO
# SLACK_WEBHOOK_URL=your_slack_webhook_url

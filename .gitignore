# Git ignore patterns
.git
.gitignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MLflow
mlruns/
.mlflow/

# DVC
.dvc/cache/
.dvc/tmp/
.dvc/plots/

# Logs
logs/
*.log

# Data (tracked by DVC)
data/raw/*.csv
data/raw/*.parquet
data/processed/*.pkl
!data/.gitkeep

# Models (tracked by DVC)
models/trained/*.pkl
models/trained/*.pth
!models/.gitkeep

# Results
results/
eval_metrics_cm.png

# Environment
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.bak
.cache/
